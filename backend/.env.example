PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ai-mystery-room
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
GEMINI_MEDIA_GENERATION_ENABLED=false
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
NODE_ENV=development
SCENARIO_MAX_LENGTH=2000
GEMINI_MAX_ATTEMPTS=3
GEMINI_RETRY_DELAY_MS=1000
GEMINI_TEXT_TIMEOUT_MS=60000
GEMINI_IMAGE_TIMEOUT_MS=90000
GEMINI_VIDEO_TIMEOUT_MS=240000
